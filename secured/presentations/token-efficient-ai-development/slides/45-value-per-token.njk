<!-- ════════════════ 45 · VALUE PER TOKEN ════════════════ -->
  <section data-label="Value per token" class="slide light">
    <div class="glow soft"></div>
    <div class="frame">
      <p class="eyebrow"><span class="num">45</span>AI across the lifecycle</p>
      <h2 class="h2">Where does AI deliver the most <span class="accent">value per token</span>?</h2>

      <div class="frame-body">
      <div class="axis">
        <div class="axis-track">
          <span class="axis-pole left">Low value</span>
          <div class="axis-rail">
          <div class="axis-line"></div>
          <div class="axis-nodes">
          <div class="axis-node" style="--c: #94a3b8;">
            <span class="nd-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
            </span>
            <h3>Complex legacy</h3>
            <span class="nd-range">low</span>
          </div>
          <div class="axis-node" style="--c: #0891b2;">
            <span class="nd-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M9 11l3 3 8-8"/><path d="M20 12v6a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h9"/></svg>
            </span>
            <h3>Code review</h3>
            <span class="nd-range">medium</span>
          </div>
          <div class="axis-node" style="--c: #2563eb;">
            <span class="nd-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="m9 9 3 3-3 3"/><line x1="13" y1="15" x2="16" y2="15"/></svg>
            </span>
            <h3>Debugging</h3>
            <span class="nd-range">medium</span>
          </div>
          <div class="axis-node" style="--c: #7c3aed;">
            <span class="nd-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
            </span>
            <h3>Boilerplate</h3>
            <span class="nd-range">high</span>
          </div>
          <div class="axis-node" style="--c: #0d9488;">
            <span class="nd-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            </span>
            <h3>Planning and docs</h3>
            <span class="nd-range">high</span>
          </div>
          </div>
          </div>
          <span class="axis-pole right">High value</span>
        </div>
      </div>

      <div class="callout">
        High value on scoped, repeatable work. Low value in large, familiar codebases. <strong>Always verify the output</strong>.
      </div>
      </div>
    </div>
    {% set slideNumber = "45" %}
    {% set slideTotal = "50" %}
    {% include "../../shared/chrome.njk" %}
  </section>
