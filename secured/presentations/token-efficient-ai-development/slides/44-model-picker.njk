<!-- ════════════════ 44 · PICK THE MODEL ════════════════ -->
  <section data-label="Pick the model" class="slide light cat-themed" style="--c: #7c3aed;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">44</span>Model choice</p>
          <h2 class="h2">Pick the model for <span class="accent">the task</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="problist">
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m13 2-10 12h9l-1 8 10-12h-9z"/></svg>
          </span>
          <div class="prob-title">Small &amp; fast</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Haiku, Gemini Flash, a mini/nano model. Renames, boilerplate, simple edits and quick questions. Cheapest by far.</div>
        </div>
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          </span>
          <div class="prob-title">Mid-tier</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Sonnet, GPT-5.4. The default workhorse for most coding: enough reasoning for real features at a sane price.</div>
        </div>
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
          </span>
          <div class="prob-title">Top tier</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Opus, Fable, GPT-5.5. Reserve for genuinely hard reasoning, tricky debugging and architecture, where quality earns the cost.</div>
        </div>
      </div>

      <div class="callout">
        Changing the <strong>effort</strong> is often a better lever than changing the <strong>model</strong>.
      </div>
      </div>
    </div>
    {% set slideNumber = "44" %}
    {% set slideTotal = "56" %}
    {% include "../../shared/chrome.njk" %}
