<!-- ════════════════ 48 · TRACK B RECAP ════════════════ -->
  <section data-label="Track B recap" class="slide light cat-themed" style="--c: #16a34a;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">48</span>Track B recap</p>
          <h2 class="h2">What the API track taught us.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="checklist" style="margin-top: 20px; gap: 22px 64px;">
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Cache stable prefixes</h4>
            <p>System prompts and examples reused across calls drop input cost by up to 90%.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Batch and flex non-urgent work</h4>
            <p>The Batch API cuts cost 50% for anything that tolerates a delay.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Route by task</h4>
            <p>Small or deterministic tasks go to a cheaper model; heavy reasoning goes to a larger one.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Tune effort before switching models</h4>
            <p>Try a lower thinking budget first; the gain is often enough.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Cap output</h4>
            <p>Structured output and <code>max_tokens</code> prevent runaway generation that costs 3 to 6 times input.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Measure cost per outcome</h4>
            <p>Cost per merged PR or resolved issue, not cost per token.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Allocate to a user</h4>
            <p>Tag every call with user and feature metadata so you know who incurs the cost.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Set a hard brake</h4>
            <p><code>max_turns</code> and <code>max_budget_usd</code> in code, plus a workspace spend limit in the Console.</p>
          </div>
        </div>
      </div>
      </div>
    </div>
    {% set slideNumber = "48" %}
    {% set slideTotal = "55" %}
    {% include "../../shared/chrome.njk" %}
  </section>
