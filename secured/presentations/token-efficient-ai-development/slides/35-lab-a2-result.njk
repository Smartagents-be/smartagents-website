<!-- ════════════════ 35 · LAB A2 · RESULT ════════════════ -->
  <section data-label="Lab A2: result" class="slide light cat-themed" style="--c: #16a34a;">
    <div class="glow soft"></div>
    <div class="frame">
      <p class="eyebrow"><span class="num">35</span>Lab A2 result</p>
      <h2 class="h2">The reusable setup, in tokens.</h2>

      <div class="frame-body">
        <!-- TODO: replace 00,000 / 00% with the measured token counts (user will supply) -->
        <div style="display: grid; grid-template-columns: 1fr auto 1fr auto 1fr; align-items: center; gap: 22px; text-align: center;">
          <div>
            <div style="font-size: 23px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #94a3b8;">Initial</div>
            <div style="font-size: 112px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: #94a3b8;">00,000</div>
            <div style="font-size: 20px; color: var(--fg-muted); margin-top: 6px;">Lab 0 baseline</div>
          </div>
          <div style="font-size: 56px; line-height: 1; color: #cbd5e1;">&rarr;</div>
          <div>
            <div style="font-size: 23px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: #64748b;">Previous</div>
            <div style="font-size: 112px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: #64748b;">00,000</div>
            <div style="font-size: 20px; color: var(--fg-muted); margin-top: 6px;">after Lab A1</div>
          </div>
          <div style="font-size: 56px; line-height: 1; color: var(--c);">&rarr;</div>
          <div>
            <div style="font-size: 23px; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--c);">Current</div>
            <div style="font-size: 112px; font-weight: 800; line-height: 1; letter-spacing: -0.03em; color: var(--c);">00,000</div>
            <div style="font-size: 20px; color: var(--fg-muted); margin-top: 6px;">after the setup</div>
          </div>
        </div>
        <p style="text-align: center; font-size: 30px; color: var(--fg-muted); margin: 36px 0 0;"><strong style="color: var(--c);">00%</strong> fewer tokens than the Lab 0 baseline <span style="color: #94a3b8;">(placeholder)</span></p>
      </div>
    </div>
    {% set slideNumber = "35" %}
    {% set slideTotal = "57" %}
    {% include "../../shared/chrome.njk" %}
  </section>
