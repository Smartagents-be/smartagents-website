<!-- ════════════════ 13 · EXAMPLE · SESSION HYGIENE ════════════════ -->
  <section data-label="Example: session" class="slide light cat-themed" style="--c: #0d9488;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">13</span>Example</p>
          <h2 class="h2">Compact or start <span class="accent">fresh</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-2" style="margin-top: 32px; gap: 40px; align-content: start;">

        <div class="ide-col">
          <span class="lab">Keep the thread</span>
          <div class="ide ide-claude">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">claude - terminal</span>
            </div>
            <pre class="ide-body"><span class="pr">&gt;</span> /compact
<span class="ok">✓</span> Conversation summarized
  context 82% <span class="cmt">→</span> 31%</pre>
          </div>
          <p class="ide-cap">Compact and keep working in the same session.</p>
        </div>

        <div class="ide-col">
          <span class="lab">Start fresh</span>
          <div class="ide ide-claude">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">claude - terminal</span>
            </div>
            <pre class="ide-body"><span class="pr">&gt;</span> /clear
<span class="ok">✓</span> New session
  clean context</pre>
          </div>
          <p class="ide-cap">New task? Start fresh, or open a new chat.</p>
        </div>

      </div>
      </div>
    </div>
    {% set slideNumber = "13" %}
    {% set slideTotal = "57" %}
    {% include "../../shared/chrome.njk" %}
  </section>
