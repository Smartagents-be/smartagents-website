<!-- ════════════════ 47 · ANTI-PATTERNS ════════════════ -->
  <section data-label="Anti-patterns" class="slide light cat-themed" style="--c: #d97706;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">47</span>Anti-patterns</p>
          <h2 class="h2">Four habits that <span class="accent">waste tokens</span> and hurt quality.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="problist">
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
          </span>
          <div class="prob-title">Pasting the whole log</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Paste only the one error line and its immediate context. The rest is noise the model has to work around.</div>
        </div>
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          </span>
          <div class="prob-title">Regenerating the whole file</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Ask for the diff. Sending and receiving the full file on every iteration multiplies both cost and review time.</div>
        </div>
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
          </span>
          <div class="prob-title">Re-explaining conventions every prompt</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Write them once in an instruction file (CLAUDE.md, <code>.cursor/rules</code>, a system prompt). The model reads it on every call.</div>
        </div>
        <div class="prob-row">
          <span class="prob-ic">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg>
          </span>
          <div class="prob-title">Letting an agent loop unbounded</div>
          <div class="prob-conseq"><span class="arr">&rarr;</span>Set <code>max_turns</code> and a spend cap. A runaway loop can burn a significant budget in minutes.</div>
        </div>
      </div>
      </div>
    </div>
    {% set slideNumber = "47" %}
    {% set slideTotal = "50" %}
    {% include "../../shared/chrome.njk" %}
  </section>
