<!-- ════════════════ 60 · QUICK WINS ════════════════ -->
  <section data-label="Quick wins" class="slide light cat-themed" style="--c: #0ea5e9;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"/><path d="M12 15l-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">60</span>Where to start</p>
          <h2 class="h2">Three quick wins with <span class="accent">immediate impact</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="picks">
        <div class="pick">
          <div class="pk-n">01</div>
          <h3>Set up rule files</h3>
          <p>One CLAUDE.md or rule set per project saves tokens and repetition from day one.</p>
        </div>
        <div class="pick">
          <div class="pk-n">02</div>
          <h3>Enable prompt caching</h3>
          <p>For any repeated context. The fastest saving with the least effort.</p>
        </div>
        <div class="pick">
          <div class="pk-n">03</div>
          <h3>Choose your model deliberately</h3>
          <p>A small model by default, the top model only where it's truly needed.</p>
        </div>
      </div>
      </div>
    </div>
    {% set slideNumber = "60" %}
    {% set slideTotal = "62" %}
    {% include "../../shared/chrome.njk" %}
  </section>
