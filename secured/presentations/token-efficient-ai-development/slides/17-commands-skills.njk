<!-- ════════════════ 17 · REUSABLE PROMPTS & COMMANDS ════════════════ -->
  <section data-label="Commands" class="slide light cat-themed" style="--c: #db2777;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect width="18" height="18" x="3" y="3" rx="2"/><path d="m7 9 3 3-3 3"/><path d="M13 15h4"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">17</span>Extend</p>
          <h2 class="h2">Save recurring prompts and call them <span class="accent">on demand</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-3" style="margin-top: 36px; align-content: start;">
        <div class="card">
          <span class="lab">Claude Code</span>
          <h3>Slash commands</h3>
          <ul>
            <li>Custom commands in <code>.claude/commands</code>, invoked with <code>/</code>.</li>
            <li>Part of Skills since 2026; commands still work.</li>
          </ul>
        </div>
        <div class="card">
          <span class="lab">Cursor</span>
          <h3>Commands</h3>
          <ul>
            <li><code>.cursor/commands/*.md</code>.</li>
            <li>Typed with <code>/</code> in the Agent.</li>
          </ul>
        </div>
        <div class="card">
          <span class="lab">GitHub Copilot</span>
          <h3>Prompt files</h3>
          <ul>
            <li><code>.github/prompts/*.prompt.md</code>, invoked with <code>/name</code>.</li>
            <li>Frontmatter selects model, tools and agent.</li>
          </ul>
        </div>
      </div>

      <div class="callout">
        Write it once, well, then reuse endlessly. <strong>Saves tokens and gives consistent output</strong>.
      </div>
      </div>
    </div>
    {% set slideNumber = "17" %}
    {% set slideTotal = "50" %}
    {% include "../../shared/chrome.njk" %}
