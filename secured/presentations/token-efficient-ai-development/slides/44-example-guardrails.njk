<!-- ════════════════ 44 · EXAMPLE · GUARDRAILS ════════════════ -->
  <section data-label="Example: guardrails" class="slide light cat-themed" style="--c: #0d9488;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">44</span>Example</p>
          <h2 class="h2">Set a <span class="accent">hard brake</span>, not just an alarm.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-2" style="margin-top: 28px; gap: 40px; align-content: start;">

        <div class="ide-col">
          <span class="lab">In code &middot; Agent SDK</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">options.py</span>
            </div>
            <pre class="ide-body">options = ClaudeAgentOptions(
    <span class="key">max_turns</span>=20,
    <span class="key">max_budget_usd</span>=5.00,
)</pre>
          </div>
          <p class="ide-cap">Stops with <code>error_max_budget_usd</code> / <code>error_max_turns</code>.</p>
        </div>

        <div class="ide-col">
          <span class="lab">In the UI</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">Console &middot; Workspace</span>
            </div>
            <pre class="ide-body">Monthly spend limit
  $200 / month
<span class="cmt">→ blocks when exceeded</span></pre>
          </div>
          <p class="ide-cap">Also in Copilot (&ldquo;stop at budget&rdquo;) and Cursor (team limit).</p>
        </div>

      </div>
      <p style="font-size: 15px; line-height: 1.45; color: #94a3b8; margin: 14px 4px 0;"><strong>Sources:</strong> Claude Agent SDK (code.claude.com) &middot; Anthropic Console workspace spend limits &middot; GitHub Copilot &amp; Cursor spend limits.</p>
      </div>
    </div>
    {% set slideNumber = "44" %}
    {% set slideTotal = "55" %}
    {% include "../../shared/chrome.njk" %}
