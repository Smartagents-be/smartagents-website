<!-- ════════════════ 48 · TIPS & TRICKS RECAP ════════════════ -->
  <section data-label="Tips &amp; tricks recap" class="slide light cat-themed" style="--c: #16a34a;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">48</span>Tips &amp; tricks recap</p>
          <h2 class="h2">What these tips give you.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="checklist" style="margin-top: 20px; gap: 22px 64px;">
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Build for small context</h4>
            <p>Small, single-purpose files and clear boundaries mean a change needs less of the codebase.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Let structure do the scoping</h4>
            <p>Feature folders and clear names point the agent at the right file without grepping the repo.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Plan before you code</h4>
            <p>Agree the approach in prose first; a wrong plan is a sentence to fix, not a diff to revert.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Work in small steps</h4>
            <p>One change at a time: smaller diffs, smaller context, easier review.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Pick the model for the task</h4>
            <p>Default to the cheapest tier that clears the work; reserve the top tier for hard reasoning.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg></span>
          <div>
            <h4>Effort before models</h4>
            <p>Dial the reasoning budget down first; it often closes the gap without a bigger model.</p>
          </div>
        </div>
      </div>
      </div>
    </div>
    {% set slideNumber = "48" %}
    {% set slideTotal = "56" %}
    {% include "../../shared/chrome.njk" %}
  </section>
