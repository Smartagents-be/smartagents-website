<!-- ════════════════ 31 · MODEL ROUTING ════════════════ -->
  <section data-label="Model routing" class="slide light cat-themed" style="--c: #4f46e5;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"/><circle cx="18" cy="6" r="3"/><circle cx="6" cy="18" r="3"/><path d="M18 9a9 9 0 0 1-9 9"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">31</span>Model routing</p>
          <h2 class="h2">Not every task needs the <span class="accent">most expensive model</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-3" style="margin-top: 28px; align-content: start;">
        <div class="card">
          <span class="num-lg">01</span>
          <h3>Small and fast</h3>
          <p>Haiku, Gemini Flash, GPT-5.4-nano. Roughly $0.20 to $1.50 per million input. For autocomplete, classification and simple edits.</p>
        </div>
        <div class="card">
          <span class="num-lg">02</span>
          <h3>Mid-tier</h3>
          <p>Claude Sonnet 4.6, GPT-5.4. About $2.50 to $3 input. The workhorses for most coding tasks.</p>
        </div>
        <div class="card">
          <span class="num-lg">03</span>
          <h3>Top model</h3>
          <p>Claude Opus 4.8, GPT-5.5. About $5 input and $25 to $30 output. Reserve for genuinely complex reasoning.</p>
        </div>
      </div>

      <div class="callout">
        Most capable: <strong>Claude Fable 5 ($10/$50)</strong>, reserve for the hardest reasoning. Prices June 2026, check current rates.
      </div>
      </div>
    </div>
    {% set slideNumber = "31" %}
    {% set slideTotal = "50" %}
    {% include "../../shared/chrome.njk" %}
  </section>
