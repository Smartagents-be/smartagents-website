<!-- ════════════════ 39 · EXAMPLE · CACHING ════════════════ -->
  <section data-label="Example: caching" class="slide light cat-themed" style="--c: #2563eb;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">39</span>Example</p>
          <h2 class="h2">Cache the stable part <span class="accent">first</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-2" style="margin-top: 28px; gap: 40px; align-content: start;">

        <div class="ide-col">
          <span class="lab">Stable prefix + cache_control</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">messages.create()</span>
            </div>
            <pre class="ide-body">{
  <span class="key">"system"</span>: [{ <span class="key">"type"</span>: <span class="str">"text"</span>,
    <span class="key">"text"</span>: <span class="str">"&lt;TypeScript code-review rules
             + 20 review examples&gt;"</span>,
    <span class="key">"cache_control"</span>: {<span class="key">"type"</span>:<span class="str">"ephemeral"</span>} }],
  <span class="key">"messages"</span>: [{ <span class="key">"role"</span>: <span class="str">"user"</span>,
    <span class="key">"content"</span>: <span class="str">"&lt;PR diff to review&gt;"</span> }]
}</pre>
          </div>
          <p class="ide-cap">Stable review rules first, the diff last.</p>
        </div>

        <div class="ide-col">
          <span class="lab">Verify &amp; avoid breakage</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">note</span>
            </div>
            <pre class="ide-body"><span class="cmt"># breaks the cache:</span>
<span class="str">"Today is "</span> + datetime.now()

<span class="cmt"># check that it works:</span>
usage.cache_read_input_tokens</pre>
          </div>
          <p class="ide-cap">One byte difference at the front = cache miss.</p>
        </div>

      </div>

      <div class="callout">
        Cache read ~0.1x (90% off); write 1.25x (5-min TTL) or 2x (1-hour TTL). Minimum cacheable prefix is per-model, <strong>1024 tokens on Opus 4.8 and Sonnet 4.6, 4096 on Haiku 4.5</strong>.
      </div>

      <p style="font-size: 15px; line-height: 1.45; color: #94a3b8; margin: 14px 4px 0;"><strong>Source:</strong> Anthropic, prompt caching (platform.claude.com/docs, 2026-06-17). Automatic caching for multi-turn; manual <code>cache_control</code> on the last stable block.</p>
      </div>
    </div>
    {% set slideNumber = "39" %}
    {% set slideTotal = "62" %}
    {% include "../../shared/chrome.njk" %}
  </section>
