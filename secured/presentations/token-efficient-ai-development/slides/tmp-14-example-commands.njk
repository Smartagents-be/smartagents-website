<!-- ════════════════ 14 · EXAMPLE · COMMANDS & PROMPTS ════════════════ -->
  <section data-label="Example: commands" class="slide light cat-themed" style="--c: #db2777;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">14</span>Example</p>
          <h2 class="h2">One file, then call it with <span class="accent">/</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="grid-3" style="margin-top: 32px; align-content: start;">

        <div class="ide-col">
          <span class="lab">Claude Code</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">.claude/commands/review.md</span>
            </div>
            <pre class="ide-body">Review the diff for bugs
and security.
Give a short list.</pre>
          </div>
          <p class="ide-cap">Invoke with <code>/review</code>.</p>
        </div>

        <div class="ide-col">
          <span class="lab">Cursor</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">.cursor/commands/test.md</span>
            </div>
            <pre class="ide-body">Write unit tests for
the selected function.</pre>
          </div>
          <p class="ide-cap">Invoke with <code>/test</code>.</p>
        </div>

        <div class="ide-col">
          <span class="lab">GitHub Copilot</span>
          <div class="ide">
            <div class="ide-bar">
              <span class="ide-dots"><span class="ide-dot r"></span><span class="ide-dot y"></span><span class="ide-dot g"></span></span>
              <span class="ide-file">refactor.prompt.md</span>
            </div>
            <pre class="ide-body"><span class="cmt">---</span>
<span class="key">description</span>: <span class="str">"Refactor"</span>
<span class="cmt">---</span>
Refactor the selection into
small functions.</pre>
          </div>
          <p class="ide-cap">Invoke with <code>/refactor</code>.</p>
        </div>

      </div>

      <div class="callout">
        Write out the workflow once, <strong>never type it in full again</strong>.
      </div>
      </div>
    </div>
    {% set slideNumber = "14" %}
    {% set slideTotal = "50" %}
    {% include "../../shared/chrome.njk" %}
  </section>
