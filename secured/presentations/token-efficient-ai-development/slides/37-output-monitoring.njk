<!-- ════════════════ 37 · OUTPUT & MONITORING ════════════════ -->
  <section data-label="Output &amp; monitoring" class="slide light cat-themed" style="--c: #0891b2;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20V10"/><path d="M18 20V4"/><path d="M6 20v-4"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">37</span>Output &amp; monitoring</p>
          <h2 class="h2">Control the <span class="accent">expensive side</span>: output.</h2>
        </div>
      </div>

      <div class="frame-body">
      <div class="checklist">
        <div class="check-item">
          <span class="ck">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <h4>Force compact output</h4>
            <p>Ask only for what's needed. Minimal, structured output can cut token usage by 60 to 80 percent.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <h4>Use structured output</h4>
            <p>A JSON schema stops the model from rambling in long prose.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <h4>Ask only for the diff</h4>
            <p>Have the agent return changed lines, not the whole file again.</p>
          </div>
        </div>
        <div class="check-item">
          <span class="ck">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
          </span>
          <div>
            <h4>Measure and set limits</h4>
            <p>Track input, output and cached per feature. No measurement, no optimization.</p>
          </div>
        </div>
      </div>

      <div class="callout">
        Output costs three to six times as much as input. That's often where the <strong>biggest win</strong> is.
      </div>
      </div>
    </div>
    {% set slideNumber = "37" %}
    {% set slideTotal = "55" %}
    {% include "../../shared/chrome.njk" %}
  </section>
