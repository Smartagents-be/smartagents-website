<!-- ════════════════ 06B · INDEXATIE WORKFLOW ════════════════ -->
  <section data-label="Indexatie workflow" class="slide light cat-themed" style="--c: #d97706;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polyline points="22 7 13.5 15.5 8.5 10.5 2 17"/><polyline points="16 7 22 7 22 13"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">06</span>Indexatie</p>
          <h2 class="h2">Van jaarlijkse taak tot verstuurde brief in <span class="accent">vier stappen</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
        <div class="steps" style="margin-top: 40px; grid-template-columns: repeat(4, 1fr);">
          <div class="step" style="--c: #2563eb;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M22 19a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h5l2 3h9a2 2 0 0 1 2 2z"/></svg>
              </span>
              <span class="big-n">01</span>
            </div>
            <h4>Google Drive scan</h4>
            <p>LeaseLens scant automatisch de contractenmap. Ingangsdatum, basishuur en indexmaand worden per contract herkend &mdash; zonder &eacute;&eacute;n handmatige invoer.</p>
          </div>

          <div class="step" style="--c: #d97706;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
              </span>
              <span class="big-n">02</span>
            </div>
            <h4>StatBel raadpleging</h4>
            <p>De gezondheidsindex wordt live opgevraagd bij StatBel. De wettelijke formule wordt automatisch toegepast op elk contract.</p>
          </div>

          <div class="step" style="--c: #7c3aed;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              </span>
              <span class="big-n">03</span>
            </div>
            <h4>Overzicht nakijken</h4>
            <p>U krijgt een overzicht van alle nieuwe huurprijzen per pand. Correcties zijn mogelijk v&oacute;&oacute;r u verdergaat naar de brieven.</p>
          </div>

          <div class="step" style="--c: #059669;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
              </span>
              <span class="big-n">04</span>
            </div>
            <h4>Conceptbrieven via Gmail</h4>
            <p>Per huurder staat een gepersonaliseerde brief klaar in Gmail. &Eacute;&eacute;n klik per huurder om te versturen.</p>
          </div>
        </div>
      </div>
    </div>
    {% set slideNumber = "06" %}
    {% set slideTotal = "08" %}
    {% include "../../shared/chrome.njk" %}
  </section>
