<!-- ════════════════ 01 · WAAROM LEASELENS ════════════════ -->
  <section data-label="Waarom LeaseLens" class="slide light" style="--c: #d97706;">
    <div class="glow soft"></div>
    <div class="frame">
      <p class="eyebrow"><span class="num">01</span>Aanleiding</p>
      <h2 class="h2">Plaatsbeschrijvingen zijn <span class="accent">tijdrovend en foutgevoelig</span>.</h2>

      <div class="frame-body">
        <div class="problist">
          <div class="prob-row">
            <span class="prob-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="9" y1="15" x2="15" y2="15"/><line x1="9" y1="11" x2="15" y2="11"/></svg>
            </span>
            <span class="prob-title">Papier en PDF</span>
            <span class="prob-conseq"><span class="arr">&#x2192;</span>Checklists op papier, handmatig overgetypt, geen centrale opslag en snel kwijt bij geschil.</span>
          </div>
          <div class="prob-row">
            <span class="prob-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="1" y1="1" x2="23" y2="23"/><path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 5.17-2.39"/><path d="M10.71 5.05A16 16 0 0 1 22.56 9"/><path d="M1.42 9a15.91 15.91 0 0 1 4.7-2.88"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/></svg>
            </span>
            <span class="prob-title">Geen toegang op locatie</span>
            <span class="prob-conseq"><span class="arr">&#x2192;</span>Zonder internet valt een tool uit. De inspecteur staat op locatie met een lege pagina.</span>
          </div>
          <div class="prob-row">
            <span class="prob-ic">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </span>
            <span class="prob-title">Rapport kost uren extra werk</span>
            <span class="prob-conseq"><span class="arr">&#x2192;</span>Een professioneel PDF-verslag is een aparte klus na de inspectie, ver van de feiten en foto's.</span>
          </div>
        </div>

        <div class="callout">
          LeaseLens lost alle drie op: offline-first, met foto's en AI, en exporteert direct naar <strong>PDF</strong>.
        </div>
      </div>
    </div>
    {% set slideNumber = "01" %}
    {% set slideTotal = "08" %}
    {% include "../../shared/chrome.njk" %}
  </section>
