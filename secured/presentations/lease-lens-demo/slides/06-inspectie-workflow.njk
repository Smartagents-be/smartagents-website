<!-- ════════════════ 06 · INSPECTIE WORKFLOW ════════════════ -->
  <section data-label="Inspectie workflow" class="slide light cat-themed" style="--c: #0891b2;">
    <div class="glow soft"></div>
    <div class="frame">
      <div class="cat-head">
        <span class="cat-icon">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg>
        </span>
        <div class="cat-text">
          <p class="eyebrow"><span class="num">05</span>Workflow</p>
          <h2 class="h2">Van aankomst tot rapport in <span class="accent">vier stappen</span>.</h2>
        </div>
      </div>

      <div class="frame-body">
        <div class="steps" style="margin-top: 40px; grid-template-columns: repeat(4, 1fr);">
          <div class="step" style="--c: #0891b2;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
              </span>
              <span class="big-n">01</span>
            </div>
            <h4>Pand aanmaken</h4>
            <p>Adres, verhuurder, huurder en ruimtes configureren. Eenmalig, herbruikbaar bij elke inspectie.</p>
          </div>

          <div class="step" style="--c: #7c3aed;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
              </span>
              <span class="big-n">02</span>
            </div>
            <h4>Ruimtes inspecteren</h4>
            <p>Foto's nemen, schade noteren, meterstand invoeren. Alles werkt volledig offline op de smartphone.</p>
          </div>

          <div class="step" style="--c: #d97706;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
              </span>
              <span class="big-n">03</span>
            </div>
            <h4>AI-verwerking</h4>
            <p>Foto's geanalyseerd door het LLM, checklijst automatisch ingevuld, overzicht per ruimte opgesteld.</p>
          </div>

          <div class="step" style="--c: #059669;">
            <div class="step-head">
              <span class="step-icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
              </span>
              <span class="big-n">04</span>
            </div>
            <h4>Rapport downloaden</h4>
            <p>PDF gegenereerd, klaar voor ondertekening door verhuurder en huurder.</p>
          </div>
        </div>
      </div>
    </div>
    {% set slideNumber = "05" %}
    {% set slideTotal = "08" %}
    {% include "../../shared/chrome.njk" %}
  </section>
