<!-- ════════════════ 08 · VOLGENDE STAP ════════════════ -->
  <section data-label="Volgende stap" class="slide light">
    <div class="glow soft"></div>
    <div class="frame">
      <p class="eyebrow"><span class="num">08</span>Volgende stap</p>
      <h1 class="title" style="font-size: 60px; max-width: 1500px;">U heeft de demo gezien. <span class="accent">Probeer het zelf.</span></h1>

      <div class="frame-body">
        <div style="display: grid; grid-template-columns: 0.95fr 1.05fr; gap: 46px; margin-top: 24px; align-items: center;">
          <div style="display: flex; flex-direction: column; justify-content: center; max-width: 560px;">
            <p class="body" style="font-size: 27px; line-height: 1.5; max-width: 560px;">
              U heeft tijdelijk toegang tot LeaseLens om de app zelf te verkennen. Ga gerust aan de slag. Gegevens worden na de proefperiode <strong style="color: var(--fg);">niet bewaard</strong>. We horen graag uw feedback.
            </p>
          </div>

          <div style="display: flex; flex-direction: column; gap: 16px;">
            <div class="founder" style="min-height: 184px;">
              <div class="photo" style="background-image: url('assets/axel-profile.webp');"></div>
              <div class="info" style="padding: 24px 28px;">
                <div class="role">Founder</div>
                <h3>Axel Segers</h3>
                <p>Digitale transformatie &middot; Strategie &middot; Ondernemerschap &middot; AI-adoptie.</p>
              </div>
            </div>
            <div class="founder" style="min-height: 184px;">
              <div class="photo" style="background-image: url('assets/tom-profile.webp');"></div>
              <div class="info" style="padding: 24px 28px;">
                <div class="role">Founder</div>
                <h3>Tom Haeldermans</h3>
                <p>Technische architectuur &middot; AI-engineering &middot; Implementatie.</p>
              </div>
            </div>
          </div>
        </div>

        <div style="margin-top: 48px; display: grid; grid-template-columns: 1.05fr 0.95fr 0.65fr; gap: 30px; align-items: center; padding: 22px 28px; border-radius: 20px; background: #0f172a; box-shadow: 0 20px 50px rgba(15,23,42,0.16);">
          <div>
            <div style="font-size: 18px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #00d8ff; margin-bottom: 8px;">Proeftoegang</div>
            <div style="font-size: 32px; line-height: 1.08; color: #f8fafc; font-weight: 600; letter-spacing: -0.02em;">Tijdelijk beschikbaar</div>
            <div style="font-size: 20px; line-height: 1.3; color: #94a3b8; margin-top: 8px;">Gebruik de app vrijuit. Gegevens worden na de proefperiode niet bewaard.</div>
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #00d8ff; margin-bottom: 8px;">Feedback</div>
            <div style="font-size: 24px; color: #f8fafc; font-weight: 500;">info@smartagents.be</div>
            <div style="font-size: 21px; color: #94a3b8; margin-top: 6px;">smartagents.be/contact</div>
          </div>
          <div>
            <div style="font-size: 18px; font-weight: 700; letter-spacing: 0.18em; text-transform: uppercase; color: #00d8ff; margin-bottom: 8px;">Info</div>
            <div style="font-size: 22px; color: #f8fafc; font-weight: 500;">Beringen, Belgi&euml;</div>
            <div style="font-size: 18px; color: #94a3b8; margin-top: 6px;">BE1037.114.694</div>
          </div>
        </div>
      </div>
    </div>
    {% set slideNumber = "08" %}
    {% set slideTotal = "08" %}
    {% include "../../shared/chrome.njk" %}
  </section>
