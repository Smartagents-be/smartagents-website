{#
  Sections that appear both as an anchor on the homepage (/#services, /#aanpak,
  /#contact) and as a standalone page (/services/, /aanpak/, /contact/).
  Import with context so `locale`, `site` and the `t` filter resolve.
#}

{% macro servicesGrid() %}
<div class="services-feature-grid">
    <a href="{{ "/services/training/" | locale_url | withPathPrefix }}" class="service-feature">
        <div class="service-feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                <path d="M6 12v5c0 2 2 3 6 3s6-1 6-3v-5"/>
            </svg>
        </div>
        <h3>{{ "services.training.title" | t(locale) }}</h3>
        <p>{{ "services.training.desc" | t(locale) }}</p>
        <span class="service-feature-link">{{ "services.learnmore" | t(locale) }} →</span>
    </a>
    <a href="{{ "/services/process-optimization/" | locale_url | withPathPrefix }}" class="service-feature">
        <div class="service-feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/>
            </svg>
        </div>
        <h3>{{ "services.process.title" | t(locale) }}</h3>
        <p>{{ "services.process.desc" | t(locale) }}</p>
        <span class="service-feature-link">{{ "services.learnmore" | t(locale) }} →</span>
    </a>
    <a href="{{ "/services/agentic-ai/" | locale_url | withPathPrefix }}" class="service-feature">
        <div class="service-feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <circle cx="12" cy="12" r="3"/>
                <path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"/>
            </svg>
        </div>
        <h3>{{ "services.agentic.title" | t(locale) }}</h3>
        <p>{{ "services.agentic.desc" | t(locale) }}</p>
        <span class="service-feature-link">{{ "services.learnmore" | t(locale) }} →</span>
    </a>
    <a href="{{ "/services/staffing/" | locale_url | withPathPrefix }}" class="service-feature">
        <div class="service-feature-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                <circle cx="9" cy="7" r="4"/>
                <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
        </div>
        <h3>{{ "services.staffing.title" | t(locale) }}</h3>
        <p>{{ "services.staffing.desc" | t(locale) }}</p>
        <span class="service-feature-link">{{ "services.learnmore" | t(locale) }} →</span>
    </a>
</div>
{% endmacro %}

{% macro aanpakTimeline() %}
<div class="aanpak-timeline">
    <div class="aanpak-step">
        <div class="aanpak-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="M20 20l-3.5-3.5"></path>
            </svg>
        </div>
        <div class="aanpak-number">01</div>
        <h3>{{ "approach.step1.title" | t(locale) }}</h3>
        <p>{{ "approach.step1.desc" | t(locale) }}</p>
        <a href="{{ "/services/smart-scan/" | locale_url | withPathPrefix }}" class="aanpak-link">{{ "approach.step1.btn" | t(locale) }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
    <div class="aanpak-step">
        <div class="aanpak-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M3 21h6"></path>
                <path d="M14.5 4.5a2.12 2.12 0 1 1 3 3L8 17l-4 1 1-4 9.5-9.5z"></path>
            </svg>
        </div>
        <div class="aanpak-number">02</div>
        <h3>{{ "approach.step2.title" | t(locale) }}</h3>
        <p>{{ "approach.step2.desc" | t(locale) }}</p>
        <a href="{{ "/services/ontwerp/" | locale_url | withPathPrefix }}" class="aanpak-link">{{ "approach.step2.btn" | t(locale) }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
    <div class="aanpak-step">
        <div class="aanpak-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <polyline points="16 18 22 12 16 6"></polyline>
                <polyline points="8 6 2 12 8 18"></polyline>
                <line x1="10" y1="20" x2="14" y2="4"></line>
            </svg>
        </div>
        <div class="aanpak-number">03</div>
        <h3>{{ "approach.step3.title" | t(locale) }}</h3>
        <p>{{ "approach.step3.desc" | t(locale) }}</p>
        <a href="{{ "/services/ontwikkeling/" | locale_url | withPathPrefix }}" class="aanpak-link">{{ "approach.step3.btn" | t(locale) }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
    <div class="aanpak-step">
        <div class="aanpak-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
        </div>
        <div class="aanpak-number">04</div>
        <h3>{{ "approach.step4.title" | t(locale) }}</h3>
        <p>{{ "approach.step4.desc" | t(locale) }}</p>
        <a href="{{ "/services/implementatie/" | locale_url | withPathPrefix }}" class="aanpak-link">{{ "approach.step4.btn" | t(locale) }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
    <div class="aanpak-step">
        <div class="aanpak-icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <line x1="6" y1="20" x2="6" y2="10"></line>
                <line x1="12" y1="20" x2="12" y2="4"></line>
                <line x1="18" y1="20" x2="18" y2="14"></line>
            </svg>
        </div>
        <div class="aanpak-number">05</div>
        <h3>{{ "approach.step5.title" | t(locale) }}</h3>
        <p>{{ "approach.step5.desc" | t(locale) }}</p>
        <a href="{{ "/services/optimalisatie-support/" | locale_url | withPathPrefix }}" class="aanpak-link">{{ "approach.step5.btn" | t(locale) }}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg></a>
    </div>
</div>
{% endmacro %}

{% macro contactForm() %}
<form class="contact-form" id="contact-form" action="/api/contact" method="POST">
    <input type="hidden" name="_subject" value="{{ 'contact.form.subject' | t(locale) }}">
    <input type="text" name="_honey" style="display:none">
    <div class="form-row">
        <div class="form-group">
            <label for="name">{{ "contact.form.name" | t(locale) }}</label>
            <input type="text" id="name" name="name" required>
        </div>
        <div class="form-group">
            <label for="email">{{ "contact.form.email" | t(locale) }}</label>
            <input type="email" id="email" name="email" required>
        </div>
    </div>
    <div class="form-group">
        <label for="company">{{ "contact.form.company" | t(locale) }}</label>
        <input type="text" id="company" name="company">
    </div>
    <div class="form-group">
        <label for="message">{{ "contact.form.message" | t(locale) }}</label>
        <textarea id="message" name="message" rows="5" required></textarea>
    </div>
    <div class="cf-turnstile" data-sitekey="{{ site.turnstileSiteKey }}" data-appearance="interaction-only" data-size="flexible"></div>
    <button type="submit" class="btn btn-primary"
      data-label-default="{{ 'contact.form.submit' | t(locale) }}"
      data-label-success="{{ 'contact.form.success' | t(locale) }}"
      data-label-error="{{ 'contact.form.error' | t(locale) }}">
      {{ "contact.form.submit" | t(locale) }}
    </button>
</form>
<p class="contact-phone-note">{{ "contact.phone.note" | t(locale) | safe }}</p>
{% endmacro %}
