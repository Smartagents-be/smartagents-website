# Two asset classes, two policies (fast-static-site §6).
# Later rules override earlier ones, so the generic rule goes first.
#
# There is no `Vary: Accept-Encoding` here any more. Cloudflare adds it to every
# response it compresses, so the header was a line saying what the edge already
# says — and a hand-written `Vary` on a rule this broad is the kind of thing that
# quietly splits a cache key if it ever falls out of step with the edge's own.

/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Content-hashed by Vite, so the URL changes whenever the bytes do.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Media and downloads (video, posters, one-pagers) are not content-hashed:
# revalidate daily.
/media/*
  Cache-Control: public, max-age=86400

# The service worker must never be served stale.
/sw.js
  Cache-Control: no-cache

# Deck and document assets are not hashed; revalidate daily.
/secured/*
  X-Robots-Tag: noindex, follow
  Cache-Control: public, max-age=0, must-revalidate

/favicon.svg
  Cache-Control: public, max-age=604800
